# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าตามต้องการ
# (ค่าทั้งหมดแก้ภายหลังได้จากปุ่มตั้งค่าในหน้าเว็บ)

# ที่อยู่ MQTT broker แบบ WebSocket (เบราว์เซอร์ใช้ ws:// หรือ wss:// เท่านั้น)
NEXT_PUBLIC_MQTT_URL=wss://broker.emqx.io:8084/mqtt

# ชื่ออุปกรณ์ ต้องตรงกับ DEVICE_ID ในโค้ด Arduino
# ตั้งให้เดายากเพราะ broker สาธารณะใครก็ subscribe ได้
NEXT_PUBLIC_DEVICE_ID=my-esp32-home

# ใช้เมื่อ broker ต้องล็อกอิน (เว็บนี้รันในเบราว์เซอร์ จึงมองเห็นค่านี้ได้)
NEXT_PUBLIC_MQTT_USERNAME=
